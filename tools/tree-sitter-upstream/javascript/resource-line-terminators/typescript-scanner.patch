+// Look ahead without widening the keyword span. A resource declaration cannot
+// cross a line terminator, including one inside a block comment.
+static bool resource_line_end(int32_t c) {
+    return c == '\n' || c == '\r' || c == 0x2028 || c == 0x2029;
+}
+
+static bool resource_gap(TSLexer *lexer) {
+    bool separated = false;
+    for (;;) {
+        if (resource_line_end(lexer->lookahead)) return false;
+        if (iswspace(lexer->lookahead) || lexer->lookahead == 0xfeff) {
+            separated = true;
+            advance(lexer);
+        } else if (lexer->lookahead == '/') {
+            advance(lexer);
+            if (lexer->lookahead != '*') return false;
+            advance(lexer);
+            bool closed = false;
+            while (lexer->lookahead) {
+                if (resource_line_end(lexer->lookahead)) return false;
+                if (lexer->lookahead == '*') {
+                    advance(lexer);
+                    if (lexer->lookahead == '/') {
+                        advance(lexer);
+                        closed = true;
+                        break;
+                    }
+                } else {
+                    advance(lexer);
+                }
+            }
+            if (!closed) return false;
+            separated = true;
+        } else {
+            return separated;
+        }
+    }
+}
