+static bool scan_resource_keyword(TSLexer *lexer, bool await_using) {
+    const char *keyword = await_using ? "await" : "using";
+    for (unsigned i = 0; keyword[i]; ++i) {
+        if (lexer->lookahead != keyword[i]) return false;
+        advance(lexer);
+    }
+    lexer->mark_end(lexer);
+    if (!resource_gap(lexer)) return false;
+    if (await_using) {
+        const char *using_keyword = "using";
+        for (unsigned i = 0; using_keyword[i]; ++i) {
+            if (lexer->lookahead != using_keyword[i]) return false;
+            advance(lexer);
+        }
+        if (!resource_gap(lexer)) return false;
+    }
+    int32_t c = lexer->lookahead;
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$' || c == '\\' || c > 127)) return false;
+    lexer->result_symbol = await_using ? AWAIT_USING_KEYWORD : USING_KEYWORD;
+    return true;
+}
