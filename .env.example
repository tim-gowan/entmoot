# Optional shell/IDE export template (gitignored `.env`).
# Entmoot does NOT load `.env`. SSOT is `.entmoot/adapter-profile.json` after `entmoot init`.
# Process `ENTMOOT_*` overrides remain exclusive when set.
#
# Host adapters (no Docker required):
#   python scripts/build_resolver_adapters.py
#   cargo build -p entmoot-cli --features producer
#   entmoot init
#   entmoot status
#   entmoot bind

# Shared adapter root (Go / Roslyn / Java / Clang catalog relatives)
ENTMOOT_ADAPTERS_ROOT=<repo>/.tmp/adapter-build/resolver-adapters

# Go — host sidecar (prefer over Docker)
ENTMOOT_GO_ADAPTER=<repo>/.tmp/adapter-build/resolver-adapters/go/entmoot-go-resolver.exe
# Optional Docker override only when host Go is unavailable:
# ENTMOOT_GO_ADAPTER=<repo>/.tmp/adapter-build/resolver-adapters/go/entmoot-go-resolver-docker.exe
# ENTMOOT_GO_VIA_DOCKER=1

# C# (Roslyn)
ENTMOOT_ROSLYN_ADAPTER=<repo>/.tmp/adapter-build/resolver-adapters/roslyn/bin/Release/net9.0/Entmoot.RoslynSolver.dll

# Java (javac Trees jar) — JDK 17+ on PATH or JAVA_HOME
ENTMOOT_JAVA_ADAPTER=<repo>/.tmp/adapter-build/resolver-adapters/java/entmoot-java-resolver.jar
# JAVA_HOME=

# C/C++ (Clang) + libclang
ENTMOOT_CLANG_ADAPTER=<repo>/.tmp/adapter-build/resolver-adapters/clang/entmoot-clang-resolver.py
# LIBCLANG_PATH=
# PYTHONPATH=

# Python Program
ENTMOOT_PYRIGHT_ADAPTER=<repo>/.tmp/adapter-build/pyright-program/entmoot-pyright.cjs
# ENTMOOT_PYTHON_ENVIRONMENT=<repo>/.entmoot/python_environment.json

# Do NOT set ENTMOOT_TYPESCRIPT_ADAPTER for default Oxc P1 JS/TS binds.
